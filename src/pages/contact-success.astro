---
import {deploymentPolicy} from '../../config/deployment-policy.mjs';
import MainLayout from '../components/MainLayout.astro';
import pages from '../data/preview-copy.json';
const metadata = pages['/contact-success'].metadata;
---
<MainLayout title="Enquiry Submitted" canonicalPath="/contact-success" seoTitle={metadata.title} seoDescription={metadata.description} robots="noindex,nofollow" showBreadcrumbs={false} showLocalSubnav={false}>
<section id="unconfirmed"><h1 class="type-h1">Submission not confirmed</h1><p>This page alone does not confirm an enquiry was accepted.</p></section>
<section id="confirmed" hidden><h1 class="type-h1">Your enquiry has been received</h1><p>Your enquiry has been received. I’ll read it personally and respond within 48 hours to the email address you provided.</p><p>Deepak Gupta</p>{deploymentPolicy.mode === 'local' && <p>Local interface test only. Service acceptance and mailbox delivery are not verified.</p>}</section>
<p><a href="/">Return to Home</a></p>
</MainLayout>
<script>
import {deploymentPolicy} from '../../config/deployment-policy.mjs';
const key = deploymentPolicy.mode === 'local' ? 'ab-preview-accepted' : 'ab-service-accepted';
if (sessionStorage.getItem(key) === '1') {
 document.querySelector<HTMLElement>('#unconfirmed')!.hidden = true;
 document.querySelector<HTMLElement>('#confirmed')!.hidden = false;
 sessionStorage.removeItem(key);
}
</script>
