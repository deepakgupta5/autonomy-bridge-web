---
import MainLayout from '../components/MainLayout.astro';
import pages from '../data/preview-copy.json';
import '../styles/copy.css';
import '../styles/core.css';
const page = pages['/contact'];
---
<MainLayout title="Contact" canonicalPath="/contact" seoTitle={page.metadata.title} seoDescription={page.metadata.description}>
<article class="approved-copy core-copy contact-copy" set:html={page.html} />
</MainLayout>
<style>
.contact-copy :global(.contact-grid){display:grid;grid-template-columns:1fr 1.2fr;gap:4rem;margin-top:2.5rem}
.contact-copy :global(header){display:grid;grid-template-columns:1fr 1.2fr;column-gap:4rem;padding:.5rem 0 2rem;border-bottom:2px solid var(--color-border-accent)}
.contact-copy :global(header h1){grid-row:1/3;font-size:clamp(2.125rem,2rem + 1vw,3rem);line-height:1.15;max-width:20ch}
.contact-copy :global(header p){grid-column:2}.contact-copy :global(header p:last-child){margin-bottom:0}
.contact-copy :global(.contact-grid h2){font-size:1.25rem}
@media(max-width:1000px){.contact-copy :global(header),.contact-copy :global(.contact-grid){column-gap:2rem}}
@media(max-width:800px){.contact-copy :global(header){display:block}.contact-copy :global(header h1){max-width:none}.contact-copy :global(.contact-grid){grid-template-columns:1fr;gap:1.5rem}}
</style>
