---
import {deploymentPolicy} from '../../config/deployment-policy.mjs';
import MainLayout from './MainLayout.astro';
import pages from '../data/preview-copy.json';
import '../styles/copy.css';
import '../styles/home.css';
import '../styles/core.css';
const { route } = Astro.props;
const page = pages[route];
// Approved public proof is already in the active copy. Legacy whole-page private
// overlays must not restore superseded wording or layouts in local reviews.
let body = page.html;
const isLegal = ['/privacy-policy', '/terms-of-use', '/cookie-policy'].includes(route);
if (isLegal) body = body.replace(/<p class="revision-date">.*?<\/p>/g, deploymentPolicy.researchRevisionDate ? `<p class="revision-date">Last updated: ${deploymentPolicy.researchRevisionDate}</p>` : '<p class="revision-date">Revision prepared for release; publication pending.</p>');
else body = body.replace(/<p class="revision-date">.*?<\/p>/g, deploymentPolicy.mode === 'production' ? `<p class="revision-date">Last updated: ${deploymentPolicy.publicationDate}</p>` : '<p class="revision-date">Revision prepared for release; publication pending.</p>');
const schema = route === '/methodology' ? [{ '@context': 'https://schema.org', '@type': 'Article', headline: page.name, datePublished: '2026-03-15', ...(deploymentPolicy.mode === 'production' ? {dateModified: deploymentPolicy.publicationDate} : {}) }] : [];
---
<MainLayout title={page.name} canonicalPath={route} seoTitle={page.metadata.title} seoDescription={page.metadata.description} schema={schema} showLocalSubnav={route === '/methodology'}>
  <article class:list={['approved-copy', { 'home-copy': route === '/', 'core-copy': ['/commercial-leadership', '/ai-consulting', '/about', '/research'].includes(route), 'policy-copy': route.includes('policy') || route === '/terms-of-use' || route === '/methodology' }]} set:html={body} />
</MainLayout>
