---
import { primaryNavItems } from "../data/ia";
import { normalizePathname, isResearchPath } from "../utils/navigation";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const normalizedCurrentPath = normalizePathname(currentPath);

function isActive(href: string): boolean {
  if (href === "/research") return isResearchPath(normalizedCurrentPath);
  if (href === "/") {
    return normalizedCurrentPath === "/";
  }
  return normalizedCurrentPath === href || normalizedCurrentPath.startsWith(`${href}/`);
}
---

<header class="site-header home-header">
  <div class="site-header-inner">
    <a class="site-brand" href="/">
      <span class="brand-badge">AB</span>
      <span class="brand-divider" aria-hidden="true"></span>
      <span class="brand-text">
        <span class="brand-name">AutonomyBridge</span>
        <span class="brand-tagline">Commercial leadership and AI implementation</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      {
        primaryNavItems.map((item) => (
          <a
            href={item.href}
            class="type-body-sm"
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a href="/contact" class="header-cta">Discuss your business challenge</a>
    <details class="home-mobile-menu">
      <summary>Menu</summary>
      <nav aria-label="Mobile primary">
        {primaryNavItems.map((item) => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
        <a href="/contact" class="header-cta">Discuss your business challenge</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .home-mobile-menu {display:none;}
  .home-mobile-menu a[aria-current="page"] {font-weight:700;background:var(--color-bg-surface);}
  .home-header .site-header-inner {max-width:72rem;padding:1.25rem 2rem;}
  .home-header .header-cta {padding:.85rem 1rem;}
  @media (min-width:1051px) {
    .home-header .site-header-inner {flex-direction:row;align-items:center;}
    .home-header .site-nav {width:auto;gap:1rem;}
    .home-header .brand-tagline {display:none;}
  }
  @media (max-width:1050px) {
    .home-header .site-header-inner {display:flex;flex-direction:row;align-items:center;position:relative;padding:1rem;}
    .home-header .site-nav,.home-header .site-header-inner>.header-cta {display:none;}
    .home-header .brand-tagline {display:none;}
    .home-mobile-menu {display:block;}
    .home-mobile-menu summary {cursor:pointer;padding:.65rem .75rem;min-height:1.4rem;font-size:.875rem;font-weight:600;}
    .home-mobile-menu nav {position:absolute;top:100%;left:0;right:0;padding:1rem;background:white;border-bottom:1px solid var(--color-border-default);box-shadow:0 8px 12px #0f172a0d;z-index:10;display:grid;gap:.25rem;}
    .home-mobile-menu nav>a:not(.header-cta) {padding:.75rem;color:var(--color-text-primary);text-decoration:none;}
    .home-mobile-menu .header-cta {margin-top:.5rem;text-align:center;white-space:normal;line-height:1.5;}
  }
  .site-header {
    border-bottom: 0.0625rem solid var(--color-border-light);
    background: #ffffff;
  }

  .site-header-inner {
    max-width: 82rem;
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .site-brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .brand-badge {
    width: 2.1rem;
    height: 2.1rem;
    border: 1.5px solid var(--color-text-primary);
    border-radius: 0.3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
    flex-shrink: 0;
  }

  .brand-divider {
    width: 2px;
    height: 1.875rem;
    background: var(--color-border-accent);
    flex-shrink: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .brand-name {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    line-height: 1;
  }

  .brand-tagline {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .site-nav {
    display: flex;
    gap: 0.25rem 0.75rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .site-nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav a[aria-current="page"] {
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .header-cta {
    display: inline-block;
    white-space: nowrap;
    background: var(--color-cta-bg);
    color: var(--color-cta-text);
    border: 1.5px solid var(--color-cta-border);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.5rem 0.9rem;
    border-radius: 0.375rem;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
    flex-shrink: 0;
  }

  .header-cta:hover {
    background: var(--color-border-strong);
    border-color: var(--color-cta-border);
  }

  @media (max-width: 78rem) {
    .site-header-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
    }

    .site-nav {
      width: 100%;
      justify-content: flex-start;
      gap: 0.25rem 1rem;
    }
  }
</style>
