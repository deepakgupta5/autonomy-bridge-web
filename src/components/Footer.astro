---
interface FooterLink {
  label: string;
  href: string;
}

interface FooterGroup {
  heading: string;
  links: FooterLink[];
}

const footerGroups: FooterGroup[] = [{"heading": "Services", "links": [{"label": "Commercial Leadership", "href": "/commercial-leadership"}, {"label": "AI Consulting & Implementation", "href": "/ai-consulting"}]}, {"heading": "Research", "links": [{"label": "Research & Resources", "href": "/research"}, {"label": "Insights", "href": "/insights"}, {"label": "Market Overview", "href": "/market-overview"}, {"label": "Frameworks", "href": "/frameworks"}, {"label": "Use Cases", "href": "/use-cases"}, {"label": "Case Studies", "href": "/case-studies"}, {"label": "Glossary", "href": "/glossary"}, {"label": "Research Methodology", "href": "/methodology"}]}, {"heading": "Company", "links": [{"label": "About", "href": "/about"}, {"label": "Contact", "href": "/contact"}, {"label": "LinkedIn", "href": "https://www.linkedin.com/company/autonomy-bridge/"}]}, {"heading": "Legal and utility", "links": [{"label": "Privacy Policy", "href": "/privacy-policy"}, {"label": "Terms of Use", "href": "/terms-of-use"}, {"label": "Cookie Policy", "href": "/cookie-policy"}, {"label": "Sitemap", "href": "/sitemap"}]}];
---

<footer class="site-footer">
  <div class="site-footer-inner"><section><h2 class="type-h3">AutonomyBridge</h2><p>Commercial leadership, AI consulting and implementation for startups and growing businesses.</p><p>© {new Date().getFullYear()} AutonomyBridge. All rights reserved.</p></section>
    {
      footerGroups.map((group) => (
        <section class="footer-group">
          <h2 class="type-eyebrow">{group.heading}</h2>
          <ul class="footer-list">
            {
              group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="type-body-sm"
                    target={link.href.startsWith("http") ? "_blank" : undefined}
                    rel={link.href.startsWith("http") ? "noreferrer" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      ))
    }
  </div>
</footer>

<style>
  .site-footer {
    border-top: 0.0625rem solid #d1d5db;
    background: #ffffff;
  }

  .site-footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1rem;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
  }

  .footer-group {
    min-width: 0;
  }

  .footer-group h2 {
    margin: 0 0 0.5rem;
  }

  .footer-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
  }

  .footer-list a {
    color: #1f2937;
    text-decoration: none;
  }
</style>
